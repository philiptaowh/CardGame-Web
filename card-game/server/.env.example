# v2.2.0-alpha 网页版录像后端 — 环境变量模板
# 复制为 .env 并按需修改

# 服务端口
PORT=3000

# MySQL 连接
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=card_game

# CORS 白名单（逗号分隔；* 表示允许所有源，**仅 dev 用**）
# 生产环境务必列出具体域名，如 https://card.example.com
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# v2.2.1.4: admin API 鉴权 token（录像下载用, 强制 ≥ 32 字符随机）
# 部署到服务器后从 .env 复制: ssh deploy@ECS 'cat .env | grep ADMIN_TOKEN'
ADMIN_TOKEN=replace-me-with-openssl-rand-hex-32
